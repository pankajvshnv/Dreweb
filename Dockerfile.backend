# ------------------------------------------------------------------------------
# Production Node.js Express API Backend
# ------------------------------------------------------------------------------
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Install only production dependencies
COPY package*.json ./
RUN npm install --only=production

# Copy server application and schema
COPY server.js ./
COPY schema.sql ./

# Create uploads directory and seed initial assets
RUN mkdir -p uploads
COPY public/uploads/ ./uploads/

EXPOSE 5000

CMD ["node", "server.js"]
